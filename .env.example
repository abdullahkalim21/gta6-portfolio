# ─────────────────────────────────────────────────────────────
#  VICE.DEV — environment variables
#  Copy this file to `.env` (or `.env.local`) and fill in what you need.
#  EVERYTHING here is optional. With no variables set, the site runs
#  entirely from the static content in `src/content/` and `src/config/`.
# ─────────────────────────────────────────────────────────────

# Public URL of your deployed site (used for SEO / Open Graph / sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (PostgreSQL) ─────────────────────────────────────
# Enables the admin dashboard and stores contact-form messages.
# Works with Supabase, Neon, Railway, Vercel Postgres or a local Postgres.
# Example (local docker-compose): postgresql://vice:vice@localhost:5432/vice_dev
DATABASE_URL=""

# ── Admin dashboard (/admin) ──────────────────────────────────
# Password you type on /admin/login. Use something long and random.
ADMIN_PASSWORD=""
# Secret used to sign the admin session cookie (32+ random chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── Contact form emails (Resend — https://resend.com) ─────────
# If unset, messages are still saved to the database (when configured)
# and logged to the server console.
RESEND_API_KEY=""
# Where new "mission requests" are delivered.
CONTACT_TO_EMAIL=""
# Verified sender in Resend. "onboarding@resend.dev" works for testing.
CONTACT_FROM_EMAIL="VICE.DEV <onboarding@resend.dev>"

# ── Optional integrations ─────────────────────────────────────
# Your Calendly (or Cal.com) booking link, shown in the Hire section.
NEXT_PUBLIC_CALENDLY_URL=""
