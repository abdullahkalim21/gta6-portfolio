{
  "name": "vice-dev",
  "version": "1.0.0",
  "private": true,
  "description": "VICE.DEV — an open-world, neon-soaked developer portfolio template built with Next.js.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "media:screenshots": "node scripts/media/screenshots.mjs",
    "media:video": "node scripts/media/video.mjs",
    "media:encode": "node scripts/media/encode.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "^1.6.1",
    "framer-motion": "^12.43.0",
    "marked": "^15.0.12",
    "next": "15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright-core": "^1.65.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
